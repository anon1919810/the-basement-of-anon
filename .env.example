# ============================================================
# 文献文化要素提取工具 - 环境变量模板
# 用法：复制本文件为 .env 并填入真实值（.env 已被 git 忽略，不会上传）
# 云端部署请配置到 Streamlit Cloud 的 Secrets 中
# ============================================================

# DeepSeek API Key（必填，https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-你的Key

# Supabase（推荐配置；不配则用代码内默认值）
SUPABASE_URL=https://你的项目.supabase.co
SUPABASE_KEY=你的anon-key

# 会话令牌与API Key加密密钥（必配随机长串！可用以下命令生成：
#   python -c "import secrets;print(secrets.token_hex(32))"）
SESSION_SECRET=请生成随机长字符串

# 邀请码：用户填对后24小时内可使用作者API Key（留空=关闭邀请机制）
INVITE_CODE=

# 管理员用户名（逗号分隔；默认作者）
ADMIN_USERNAMES=失败主义谋士千早爱音

# 是否强制"用户必须自带Key或有邀请码才能提取"（默认true；false=人人用作者Key）
REQUIRE_KEY_OR_INVITE=true
